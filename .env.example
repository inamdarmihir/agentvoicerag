# ─────────────────────────────────────────────────────────────
#  AgentVoiceRAG – environment variables
#  Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# HuggingFace access token
# Required only for gated models (Llama, Gemma, …).
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=

# HuggingFace LLM model ID
# Default is a small, CPU-friendly model.  Override to use a larger one.
#
# Free models (no token required):
#   Qwen/Qwen2.5-0.5B-Instruct          – 0.5 B, any CPU
#   Qwen/Qwen2.5-1.5B-Instruct          – 1.5 B, fast on CPU  (default)
#   TinyLlama/TinyLlama-1.1B-Chat-v1.0  – 1.1 B
#   microsoft/Phi-3-mini-4k-instruct     – 3.8 B
#   google/gemma-2-2b-it                 – 2.0 B
#   mistralai/Mistral-7B-Instruct-v0.3   – 7.0 B (GPU recommended)
#
# Gated models (token required):
#   meta-llama/Llama-3.2-3B-Instruct
#   meta-llama/Meta-Llama-3-8B-Instruct
HF_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Quantization level: none | 4bit | 8bit
# 4bit / 8bit require a CUDA GPU + bitsandbytes.
# On CPU or MPS this setting is ignored and full precision is used.
HF_LLM_QUANTIZATION=none

# Qdrant server URL (only used when "Server" mode is selected in the UI)
QDRANT_URL=http://localhost:6333

# Qdrant API key (optional – required for Qdrant Cloud)
QDRANT_API_KEY=

# VibeVoice-ASR model ID on HuggingFace
# Default: microsoft/VibeVoice-ASR  (7 B, best quality, requires GPU)
# Lightweight alternative: openai/whisper-base
VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR
