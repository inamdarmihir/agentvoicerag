# ─────────────────────────────────────────────────────────────
#  AgentVoiceRAG – environment variables
#  Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# OpenAI API key (required for GPT-powered answers)
# Leave blank to display raw retrieved context instead.
OPENAI_API_KEY=sk-...

# Qdrant server URL (only used when "Server" mode is selected in the UI)
QDRANT_URL=http://localhost:6333

# Qdrant API key (optional – required for Qdrant Cloud)
QDRANT_API_KEY=

# VibeVoice-ASR model ID on HuggingFace
# Default: microsoft/VibeVoice-ASR  (7 B, best quality, requires GPU)
# Lightweight alternative: openai/whisper-base
VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR
